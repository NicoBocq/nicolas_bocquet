---
interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<svg class={className} viewBox="0 0 100 100" aria-hidden="true">
  <rect class="fill-foreground transition-colors" width="100" height="100" rx="22"></rect>
  <line class="stroke-background transition-colors" x1="50" y1="53" x2="61.8" y2="36.8" stroke-width="10" stroke-linecap="round"></line>
  <line class="stroke-background transition-colors" x1="50" y1="53" x2="78.5" y2="43.7" stroke-width="10" stroke-linecap="round"></line>
  <circle class="fill-background transition-colors" cx="50" cy="53" r="6"></circle>
</svg>
