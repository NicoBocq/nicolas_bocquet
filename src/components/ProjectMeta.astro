---
import { formatMonth, type Lang, t } from '../i18n'
import type { Project } from '../projects'

interface Props {
  project: Project
  lang: Lang
}

const { project, lang } = Astro.props
const { date, category } = project.data
---

<div class="flex flex-wrap gap-x-6 gap-y-1.5 font-mono text-xs tracking-wide text-muted uppercase">
  <span class="font-bold text-foreground">{formatMonth(date, lang)}</span>
  <span>{t(category, lang)}</span>
</div>
