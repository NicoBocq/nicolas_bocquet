---
import type { HTMLAttributes } from 'astro/types'
import { cva, type VariantProps } from 'class-variance-authority'

const link = cva('text-foreground', {
  variants: {
    variant: {
      solid:
        'inline-block font-mono text-xs tracking-wide after:mt-0.75 after:block after:h-0.5 after:rounded-xs after:bg-current after:transition-[background-color] after:duration-200 mouse:hover:after:bg-accent',
      reveal:
        'relative inline-flex h-8 items-center after:absolute after:inset-x-0 after:bottom-0 after:h-0.5 after:origin-left after:scale-x-0 after:rounded-xs after:bg-foreground after:transition after:duration-250 is-active:after:scale-x-100 is-active:after:bg-accent max-lg:h-7.5 mouse:hover:after:scale-x-100',
      hairline:
        'relative after:absolute after:-bottom-1 after:left-0 after:h-px after:w-full after:origin-right after:scale-x-0 after:bg-foreground after:transition hover:after:origin-left hover:after:scale-x-100',
    },
  },
  defaultVariants: { variant: 'solid' },
})

interface Props extends HTMLAttributes<'a'>, VariantProps<typeof link> {}

const { variant, class: className, ...attrs } = Astro.props
---

<a class:list={[link({ variant }), className]} {...attrs}><slot /></a>
