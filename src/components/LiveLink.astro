---
import type { Project } from '../projects'
import TextLink from './TextLink.astro'

interface Props {
  project: Project
}

const { link, host } = Astro.props.project.data
---

{
  link ? (
    <TextLink href={link} target="_blank" rel="noopener noreferrer">
      {host}
    </TextLink>
  ) : (
    <span class="text-muted">{host}</span>
  )
}
