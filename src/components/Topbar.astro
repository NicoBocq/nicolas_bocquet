---
import { site } from '../data/site'
import { type Lang, path, resolve } from '../i18n'
import { getProjects } from '../projects'
import LangSwitch from './LangSwitch.astro'
import Mark from './Mark.astro'
import TextLink from './TextLink.astro'
import ThemeToggle from './ThemeToggle.astro'

interface Props {
  lang: Lang
  route?: string
  current?: string
}

const { lang, route = '', current } = Astro.props
const nav = resolve(site.ui.nav, lang)
const projects = await getProjects()
const isHome = route === ''

const navClass =
  'flex items-center gap-7 font-mono text-xs font-medium tracking-wide whitespace-nowrap uppercase max-lg:order-3 max-lg:mt-5 max-lg:flex-none max-lg:basis-full max-lg:gap-6 max-lg:overflow-x-auto max-lg:overscroll-x-contain max-lg:border-t max-lg:py-2 max-lg:text-2xs max-lg:transition-border max-lg:scrollbar-none max-md:mt-4'
const resumeClass =
  'pl-7 font-bold before:absolute before:top-1/2 before:left-0 before:h-3 before:w-px before:-translate-y-1/2 before:bg-border before:opacity-35 after:left-7 max-lg:pl-6 max-lg:after:left-6'
---

<header class="sticky top-0 z-10 flex flex-wrap items-center gap-x-10 border-b bg-background py-5 transition-colors max-lg:pb-0 max-md:pt-4" id="topbar">
  <a class="mr-auto flex items-center gap-2 font-mono text-xl font-bold tracking-tight text-foreground max-md:text-lg" href={path(lang)} aria-label="1h12, Nicolas Bocquet"><Mark class="size-5.5 max-md:size-5" />1h12</a>
  <nav class={navClass} id="siteNav" aria-label="Projects">
    {
      projects.map((project) =>
        project.id === current ? (
          <TextLink variant="reveal" href={path(lang, project.id)} class="is-active" aria-current="page">{project.data.title}</TextLink>
        ) : (
          <TextLink variant="reveal" href={isHome ? `#${project.id}` : path(lang, project.id)}>{project.data.title}</TextLink>
        ),
      )
    }
    <TextLink variant="reveal" href={path(lang, 'resume')} class={resumeClass}>{nav.resume}</TextLink>
  </nav>
  <div class="flex items-center justify-end gap-4 max-md:gap-2">
    <LangSwitch lang={lang} route={route} />
    <ThemeToggle />
  </div>
</header>
