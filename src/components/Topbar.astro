---
import { site } from '../data/site'
import { type Lang, otherLang, path, resolve } from '../i18n'
import { getProjects } from '../projects'
import Mark from './Mark.astro'

interface Props {
  lang: Lang
  route?: string
  current?: string
}

const { lang, route = '', current } = Astro.props
const nav = resolve(site.ui.nav, lang)
const projects = await getProjects()
const other = otherLang(lang)
const isHome = route === ''
---

<header class="topbar" id="topbar">
  <a class="logo-mark font-mono" href={path(lang)} aria-label="1h12, Nicolas Bocquet"><Mark />1h12</a>
  <nav class="site-nav" id="siteNav" aria-label="Projects">
    {
      projects.map((project) =>
        project.id === current ? (
          <a href={path(lang, project.id)} class="is-active" aria-current="page">
            {project.data.title}
          </a>
        ) : (
          <a href={isHome ? `#${project.id}` : path(lang, project.id)}>{project.data.title}</a>
        ),
      )
    }
    <a href={path(lang, 'resume')} class="nav-resume">{nav.resume}</a>
  </nav>
  <div class="header-controls">
    <a class="lang-toggle" id="langToggle" href={path(other, route)} hreflang={other} data-lang-target={other} aria-label="Toggle language"></a>
    <button class="theme-toggle" id="themeToggle" aria-label="Toggle theme" aria-pressed="false" type="button"></button>
  </div>
</header>
