---
import Label from '../components/Label.astro'
import LiveLink from '../components/LiveLink.astro'
import ProjectMeta from '../components/ProjectMeta.astro'
import Shots from '../components/Shots.astro'
import TextLink from '../components/TextLink.astro'
import { site } from '../data/site'
import { type Lang, path, resolve, t } from '../i18n'
import Site from '../layouts/Site.astro'
import { getProjects } from '../projects'

interface Props {
  lang: Lang
  slug: string
}

const { lang, slug } = Astro.props
const projects = await getProjects()
const index = projects.findIndex((candidate) => candidate.id === slug)
const project = projects[index]
const next = projects[(index + 1) % projects.length]
if (!project || !next) throw new Error(`Unknown project: ${slug}`)

const labels = resolve(site.ui.work, lang)
const { title, link, models, ogImage } = project.data
const pitch = t(project.data.pitch, lang)
const story = resolve(project.data.story, lang)
---

<Site lang={lang} title={`${title} - Nicolas Bocquet`} description={pitch} route={slug} image={ogImage} ogType="article" current={slug}>
  <main class="pt-12" id="project">
    <TextLink class="mb-12" href={path(lang)}>{labels.all}</TextLink>
    <ProjectMeta project={project} lang={lang} />
    <h1 class="mt-3.5 text-display-lg font-extrabold">{title}</h1>
    <div class="mt-8 mb-16 grid gap-12 xl:grid-cols-feature xl:items-start xl:gap-14">
      <div>
        <p class="mb-10 max-w-lede text-lede">{pitch}</p>
        <Shots project={project} lang={lang} href={link} external eager />
      </div>
      <div class="grid gap-10">
        <section>
          <Label as="h2" class="mb-4">{labels.idea}</Label>
          <p class="mb-3.5 max-w-story text-lg">{story.idea}</p>
        </section>
        <section>
          <Label as="h2" class="mb-4">{labels.iterations}</Label>
          <p class="mb-3.5 max-w-story text-lg">{story.iterations}</p>
        </section>
        <section>
          <Label as="h2" class="mb-4">{labels.bench}</Label>
          <p class="mb-3.5 max-w-question text-question font-bold">{t(project.data.question, lang)}</p>
          <p class="mb-3.5 max-w-story text-lg">{story.bench}</p>
          <span class="mt-3.5 block font-mono text-xs tracking-wide text-muted">{models}</span>
        </section>
        <div class="flex flex-wrap items-baseline gap-x-8 gap-y-3 font-mono text-xs tracking-wide xl:mt-auto">
          <LiveLink project={project} />
        </div>
      </div>
    </div>
    <a class="group block border-t pt-10 pb-14 transition-border" href={path(lang, next.id)}>
      <Label>{labels.next}</Label>
      <span class="mt-3 block text-display-sm font-bold transition-[font-weight] duration-200 mouse:group-hover:font-black">{next.data.title}</span>
    </a>
  </main>
</Site>
