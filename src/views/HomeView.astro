---
import Label from '../components/Label.astro'
import LiveLink from '../components/LiveLink.astro'
import ProjectMeta from '../components/ProjectMeta.astro'
import Shots from '../components/Shots.astro'
import TextLink from '../components/TextLink.astro'
import { site } from '../data/site'
import { type Lang, path, resolve, t } from '../i18n'
import Site from '../layouts/Site.astro'
import { getProjects } from '../projects'

interface Props {
  lang: Lang
}

const HERO_WEIGHTS = [300, 900]

const { lang } = Astro.props
const { bio, career, profile, resume, skills, ui } = resolve(site, lang)
const projects = await getProjects()
const fullName = `${profile.firstname} ${profile.lastname}`
const heroLines = [profile.firstname, profile.lastname].map((name, index) => ({ letters: [...name.toUpperCase()], weight: HERO_WEIGHTS[index] }))

const knowsAbout = [...skills.tech, ...skills.ai, ...skills.product]
  .flatMap((skill) => skill.split(' / '))
  .map((skill) =>
    skill
      .trim()
      .toLowerCase()
      .replace(/\b\w/g, (char) => char.toUpperCase()),
  )

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: fullName,
  givenName: profile.firstname,
  familyName: profile.lastname,
  jobTitle: profile.shortRole,
  description: bio,
  url: `https://${profile.domain}`,
  address: { '@type': 'PostalAddress', addressLocality: 'Marseille', addressCountry: 'FR' },
  sameAs: ['https://github.com/NicoBocq', 'https://www.linkedin.com/in/bocquetnicolas'],
  knowsAbout,
  worksFor: { '@type': 'Organization', name: resume.experience[0]?.company },
  alumniOf: { '@type': 'EducationalOrganization', name: resume.education[0]?.school },
  hasOccupation: {
    '@type': 'Occupation',
    name: profile.shortRole,
    occupationLocation: { '@type': 'City', name: 'Marseille' },
    skills: skills.tech.join(', '),
  },
}
---

<Site lang={lang} title={ui.meta.home.title} description={ui.meta.home.description} jsonLd={jsonLd}>
  <section class="grid gap-10 border-b pt-12 pb-14 transition-border lg:grid-cols-intro lg:items-end lg:gap-16 lg:pt-18 lg:pb-16" id="hero">
    <div>
      <h1 class="hero-name text-hero font-bold uppercase lg:text-hero-wide" aria-label={fullName}>
        {
          heroLines.map((line) => (
            <span class="block">{line.letters.map((letter) => <span class="kinetic-letter" aria-hidden="true" style={`--w: ${line.weight}`}>{letter}</span>)}</span>
          ))
        }
      </h1>
      <p class="mt-6 font-mono text-sm font-medium tracking-wide uppercase" id="profile-role">{profile.shortRole} · {profile.location}</p>
    </div>
    <div>
      <p class="max-w-tagline text-tagline text-balance" id="profile-tagline"><strong class="block font-extrabold">{profile.tagline.lead}</strong> {profile.tagline.rest}</p>
      <p class="mt-5 max-w-premise text-muted" id="profile-premise">{profile.premise}</p>
    </div>
  </section>

  <main id="main-content">
    <ol id="journal">
      {
        projects.map((project, index) => {
          const page = path(lang, project.id)
          return (
            <li class="entry group scroll-mt-(--topbar-h) border-b pt-16 pb-18 transition-border max-md:pt-12 max-md:pb-14" id={project.id}>
              <ProjectMeta project={project} lang={lang} />
              <h2 class="mt-3.5 mb-9 text-display font-bold transition-[font-weight] duration-200 mouse:group-has-[a:hover]:font-black">
                <a href={page}>{project.data.title}</a>
              </h2>
              <div class="grid gap-8 xl:grid-cols-feature xl:gap-14">
                <Shots project={project} lang={lang} href={page} eager={index === 0} />
                <div class="flex flex-col gap-8">
                  <p class="max-w-pitch text-pitch">{t(project.data.pitch, lang)}</p>
                  <div class="border-t pt-6 transition-border">
                    <Label>{ui.work.bench}</Label>
                    <p class="mt-2.5 max-w-question text-question font-bold">{t(project.data.question, lang)}</p>
                    <span class="mt-3.5 block font-mono text-xs tracking-wide text-muted">{project.data.models}</span>
                  </div>
                  <div class="flex flex-wrap items-baseline gap-x-8 gap-y-3 font-mono text-xs tracking-wide xl:mt-auto">
                    <TextLink href={page}>
                      {ui.work.read}
                    </TextLink>
                    <LiveLink project={project} />
                  </div>
                </div>
              </div>
            </li>
          )
        })
      }
    </ol>

    <section class="grid gap-8 pt-18 pb-20 xl:grid-cols-feature xl:items-end xl:gap-14" id="colophon">
      <div>
        <Label as="h2" class="mb-5">{ui.sections.career}</Label>
        <p class="max-w-lede text-colophon text-pretty">{career.text}</p>
      </div>
      <TextLink class="justify-self-start" href={path(lang, 'resume')}>{ui.nav.fullResume}</TextLink>
    </section>
  </main>
</Site>

<script>
  import { initHero } from '../scripts/hero'
  import { trackEntries } from '../scripts/home'

  initHero()
  trackEntries()
</script>
