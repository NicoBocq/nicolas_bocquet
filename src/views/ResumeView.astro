---
import { Image } from 'astro:assets'
import profileImage from '../assets/profile.jpeg'
import { site } from '../data/site'
import { type Lang, otherLang, path, resolve, t } from '../i18n'
import Base from '../layouts/Base.astro'
import { getProjects } from '../projects'
import '../styles/resume.css'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const { bio, method, profile, resume, skills, ui } = resolve(site, lang)
const projects = await getProjects()
const other = otherLang(lang)
const [emailUser, emailDomain] = profile.email.split('@')
const languages = skills.languages.map((language) => `${language.name} (${language.level})`.toUpperCase())
const skillRows: [string, string[]][] = [
  [ui.skillLabels.product, skills.product],
  [ui.skillLabels.ai, skills.ai],
  [ui.skillLabels.tech, skills.tech],
  [ui.resume.languages, languages],
]
---

<Base lang={lang} title={ui.meta.resume.title} description={ui.meta.resume.description} route="resume" ogType="profile">
  <div class="nav-links no-print">
    <a href={path(lang)} class="back-link">{ui.nav.back}</a>
    <div class="nav-right">
      <a class="lang-toggle" id="langToggle" href={path(other, 'resume')} hreflang={other} data-lang-target={other} aria-label="Toggle language"></a>
      <button onclick="window.print()" class="print-btn" type="button">{ui.nav.print}</button>
    </div>
  </div>

  <div class="header">
    <div class="header-text">
      <h1 id="resume-name">{profile.firstname} {profile.lastname}</h1>
      <span class="role" id="resume-role">{profile.shortRole} · {profile.location}</span>
      <span class="status" id="resume-status">{profile.status}</span>
      <div class="contact-info">
        <a href="#" id="resume-email" data-email-user={emailUser} data-email-domain={emailDomain}></a>
        <a href={`https://${profile.domain}`} id="resume-website">{profile.domain}</a>
      </div>
    </div>
    <Image id="resume-image" class="resume-image" src={profileImage} alt="Profile" width={240} loading="eager" />
  </div>

  <div id="about-container" class="about-container">
    <p>{bio}</p>
  </div>

  <section>
    <h2>{ui.sections.method}</h2>
    <ul class="method" id="method-list">
      {method.map((rule) => <li>{rule}</li>)}
    </ul>
  </section>

  <section>
    <h2>{ui.resume.experience}</h2>
    <div id="experience-list">
      {
        resume.experience.map((job) => (
          <div class="experience-item">
            <h3>{job.role}</h3>
            <span class="meta">
              {job.company} | {job.period} | {job.location}
            </span>
            {job.summary && <p>{job.summary}</p>}
            {job.details && <ul>{job.details.map((detail) => <li set:html={detail} />)}</ul>}
          </div>
        ))
      }
    </div>
  </section>

  <section>
    <h2>{ui.resume.projects}</h2>
    <div id="projects-list">
      <p class="section-intro">{ui.resume.projectsIntro}</p>
      <div class="project-grid">
        {
          projects.map((project) => {
            const { title, link, host, year, stack, status } = project.data
            return (
              <div class="experience-item">
                <h3>
                  {link ? (
                    <a href={link} target="_blank" rel="noopener noreferrer">
                      {title}
                    </a>
                  ) : (
                    title
                  )}
                </h3>
                <span class="meta">
                  {year} | {link ? host : `${host} (${ui.work[status].toLowerCase()})`}
                </span>
                <p>{t(project.data.pitch, lang)}</p>
                <span class="meta">{stack.join(' · ')}</span>
              </div>
            )
          })
        }
      </div>
    </div>
  </section>

  <section>
    <h2>{ui.resume.skills}</h2>
    <div id="skills-list">
      {
        skillRows.map(([label, items]) => (
          <div class="skill-category">
            <strong class="skill-label">{label}</strong>
            <div class="skill-content">{items.join(' · ')}</div>
          </div>
        ))
      }
    </div>
  </section>

  <div class="resume-foot">
    <section>
      <h2>{ui.resume.teaching}</h2>
      <div id="teaching-list">
        {
          resume.teaching.map((course) => (
            <div class="experience-item">
              <h3>{course.role}</h3>
              <span class="meta">
                {course.school} | {course.period}
              </span>
            </div>
          ))
        }
      </div>
    </section>

    <section>
      <h2>{ui.resume.education}</h2>
      <div id="education-list">
        {
          resume.education.map((degree) => (
            <div class="experience-item">
              <h3>{degree.degree}</h3>
              <span class="meta">
                {degree.school} | {degree.period}
              </span>
            </div>
          ))
        }
      </div>
    </section>
  </div>
</Base>

<script>
  import { fillEmailLinks } from '../scripts/email'
  import { bindLangToggle } from '../scripts/lang'

  fillEmailLinks()
  bindLangToggle()
</script>
