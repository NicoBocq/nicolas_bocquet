---
import { Image } from 'astro:assets'
import profileImage from '../assets/profile.jpeg'
import ResumeEntry from '../components/ResumeEntry.astro'
import ResumeSection from '../components/ResumeSection.astro'
import { site } from '../data/site'
import { type Lang, otherLang, path, resolve, t } from '../i18n'
import Base from '../layouts/Base.astro'
import { getProjects } from '../projects'
import '../styles/resume.css'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const { bio, method, profile, resume, skills, ui } = resolve(site, lang)
const projects = await getProjects()
const other = otherLang(lang)
const [emailUser, emailDomain] = profile.email.split('@')
const languages = skills.languages.map((language) => `${language.name} (${language.level})`.toUpperCase())
const skillRows: [string, string[]][] = [
  [ui.skillLabels.product, skills.product],
  [ui.skillLabels.ai, skills.ai],
  [ui.skillLabels.tech, skills.tech],
  [ui.resume.languages, languages],
]
const buttonClass =
  'cursor-pointer border bg-background px-4 py-2 font-mono text-sm text-foreground uppercase transition-all duration-200 hover:bg-foreground hover:text-background'
const langLabel = other === 'fr' ? "after:content-['FR']" : "after:content-['EN']"
---

<Base lang={lang} title={ui.meta.resume.title} description={ui.meta.resume.description} route="resume" ogType="profile" bodyClass="light mx-auto max-w-a4 bg-background p-16 text-foreground max-md:p-6 max-md:pt-24">
  <div class="fixed inset-x-8 top-8 flex items-center justify-between max-md:inset-x-0 max-md:top-0 max-md:z-100 max-md:border-b max-md:border-border/10 max-md:bg-background/95 max-md:px-6 max-md:py-4 max-md:backdrop-blur-xs print:hidden">
    <a href={path(lang)} class={buttonClass}>{ui.nav.back}</a>
    <div class="flex items-center gap-4">
      <a class:list={[buttonClass, langLabel]} id="langToggle" href={path(other, 'resume')} hreflang={other} data-lang-target={other} aria-label="Toggle language"></a>
      <button onclick="window.print()" class={buttonClass} type="button">{ui.nav.print}</button>
    </div>
  </div>

  <div class="mb-10 flex items-start justify-between gap-8 not-print:max-md:flex-col-reverse not-print:max-md:gap-6">
    <div class="flex-1">
      <h1 class="text-4xl leading-none font-extrabold tracking-tight uppercase" id="resume-name">{profile.firstname} {profile.lastname}</h1>
      <span class="mt-2 block font-mono text-lg" id="resume-role">{profile.shortRole} · {profile.location}</span>
      <span class="mt-1.5 block font-mono text-sm text-muted" id="resume-status">{profile.status}</span>
      <div class="mt-4 flex gap-6 font-mono text-sm">
        <a class="border-b border-transparent" href="#" id="resume-email" data-email-user={emailUser} data-email-domain={emailDomain}></a>
        <a class="border-b border-transparent" href={`https://${profile.domain}`} id="resume-website">{profile.domain}</a>
      </div>
    </div>
    <Image id="resume-image" class="size-30 rounded-xs object-cover contrast-120 grayscale not-print:max-md:size-20" src={profileImage} alt="Profile" width={240} loading="eager" />
  </div>

  <div id="about-container">
    <p class="text-doc-lg text-pretty">{bio}</p>
  </div>

  <ResumeSection title={ui.sections.method}>
    <ul class="print:break-inside-avoid" id="method-list">
      {method.map((rule) => <li class="mb-0.75 text-doc font-semibold">{rule}</li>)}
    </ul>
  </ResumeSection>

  <ResumeSection title={ui.resume.experience}>
    <div id="experience-list">
      {
        resume.experience.map((job) => (
          <ResumeEntry class="mb-5 last:mb-0" title={job.role} meta={`${job.company} | ${job.period} | ${job.location}`}>
            {job.summary && <p class="mb-2 text-doc text-foreground/80 last:mb-0">{job.summary}</p>}
            {job.details && <ul class="mt-1.5 list-disc pl-4.75">{job.details.map((detail) => <li class="mb-1.25 text-doc text-foreground/80 [&_strong]:text-foreground" set:html={detail} />)}</ul>}
          </ResumeEntry>
        ))
      }
    </div>
  </ResumeSection>

  <ResumeSection title={ui.resume.projects}>
    <div id="projects-list">
      <p class="mb-5 text-doc text-muted">{ui.resume.projectsIntro}</p>
      <div class="grid grid-cols-2 gap-x-10 gap-y-6 not-print:max-md:grid-cols-1">
        {
          projects.map((project) => {
            const { title, link, host, year, stack, status } = project.data
            return (
              <ResumeEntry title={title} href={link} meta={`${year} | ${link ? host : `${host} (${ui.work[status].toLowerCase()})`}`}>
                <p class="mb-2 text-doc text-foreground/80">{t(project.data.pitch, lang)}</p>
                <span class="mt-1.5 block font-mono text-xs text-muted">{stack.join(' · ')}</span>
              </ResumeEntry>
            )
          })
        }
      </div>
    </div>
  </ResumeSection>

  <ResumeSection title={ui.resume.skills}>
    <div id="skills-list">
      {
        skillRows.map(([label, items]) => (
          <div class="mb-2 grid grid-cols-skills items-baseline gap-x-4 font-mono last:mb-0 not-print:max-md:grid-cols-1 print:break-inside-avoid">
            <strong class="text-sm">{label}</strong>
            <div class="text-xs text-foreground/80">{items.join(' · ')}</div>
          </div>
        ))
      }
    </div>
  </ResumeSection>

  <div class="grid grid-cols-resume-foot gap-x-10 gap-y-6 not-print:max-md:grid-cols-1 not-print:max-md:gap-0 print:break-inside-avoid">
    <ResumeSection title={ui.resume.teaching}>
      <div id="teaching-list">
        {resume.teaching.map((course) => <ResumeEntry class="mb-5 last:mb-0" title={course.role} meta={`${course.school} | ${course.period}`} />)}
      </div>
    </ResumeSection>

    <ResumeSection title={ui.resume.education}>
      <div id="education-list">
        {resume.education.map((degree) => <ResumeEntry class="mb-5 last:mb-0" title={degree.degree} meta={`${degree.school} | ${degree.period}`} />)}
      </div>
    </ResumeSection>
  </div>
</Base>

<script>
  import { fillEmailLinks } from '../scripts/email'
  import { bindLangToggle } from '../scripts/lang'

  fillEmailLinks()
  bindLangToggle()
</script>
