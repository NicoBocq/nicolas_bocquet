---
import Footer from '../components/Footer.astro'
import Topbar from '../components/Topbar.astro'
import type { Lang } from '../i18n'
import Base from './Base.astro'

interface Props {
  lang: Lang
  title: string
  description: string
  route?: string
  image?: string
  ogType?: string
  current?: string
  jsonLd?: Record<string, unknown>
}

const { lang, route = '', current, ...meta } = Astro.props
const bodyClass = `flex h-full flex-col bg-background text-foreground transition-colors${current ? ' page-project' : ''}`
---

<Base lang={lang} route={route} htmlClass="h-full" bodyClass={bodyClass} {...meta}>
  <div class="mx-auto flex w-full max-w-site flex-1 flex-col p-8">
    <Topbar lang={lang} route={route} current={current} />
    <slot />
    <Footer lang={lang} />
  </div>
</Base>

<script>
  import { initSite } from '../scripts/site'

  initSite()
</script>
