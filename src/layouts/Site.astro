---
import Footer from '../components/Footer.astro'
import Topbar from '../components/Topbar.astro'
import type { Lang } from '../i18n'
import Base from './Base.astro'
import '../styles/site.css'

interface Props {
  lang: Lang
  title: string
  description: string
  route?: string
  image?: string
  ogType?: string
  current?: string
  jsonLd?: Record<string, unknown>
}

const { lang, route = '', current, ...meta } = Astro.props
---

<Base lang={lang} route={route} bodyClass={current ? 'page-project' : undefined} {...meta}>
  <div class="container">
    <Topbar lang={lang} route={route} current={current} />
    <slot />
    <Footer lang={lang} />
  </div>
</Base>

<script>
  import { initSite } from '../scripts/site'

  initSite()
</script>
